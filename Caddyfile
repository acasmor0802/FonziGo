# ==============================================================================
# FonziGo - Caddy Configuration for fonzigo.app
# Automatic SSL via Let's Encrypt
# ==============================================================================

# Global options
{
    # Email for SSL certificate notifications
    email admin@fonzigo.app
    
    # Disable admin API in production (security)
    admin off
    
    # Log configuration
    log {
        output file /var/log/caddy/access.log {
            roll_size 100mb
            roll_keep 5
            roll_keep_for 720h
        }
        format json
        level INFO
    }
}

# Main domain - fonzigo.app
fonzigo.app {
    # Encode response with gzip
    encode gzip zstd
    
    # Frontend (Angular SPA) - PRESERVAR HEADERS DE NGINX
    handle / {
        reverse_proxy frontend:80 {
            # Health checks
            health_uri /health
            health_interval 30s
            health_timeout 5s
            # IMPORTANTE: Pasar headers del backend sin modificar
            header_up Host {host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
    
    # Backend API
    handle /api/* {
        reverse_proxy backend:8080 {
            # Health checks
            health_uri /actuator/health
            health_interval 30s
            health_timeout 5s
            # Pasar headers sin modificar
            header_up Host {host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
        
        # CORS y security headers (aplicados DESPUÉS del proxy)
        header {
            Access-Control-Allow-Origin "*"
            Access-Control-Allow-Methods "GET, POST, PUT, DELETE, PATCH, OPTIONS"
            Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
            Access-Control-Max-Age "86400"
            Access-Control-Allow-Credentials "true"
            X-Frame-Options "DENY"
            X-Content-Type-Options "nosniff"
            X-XSS-Protection "1; mode=block"
            Referrer-Policy "strict-origin-when-cross-origin"
        }
    }
    
    # Swagger UI (only in production if needed, can be disabled)
    handle /swagger-ui.html {
        reverse_proxy backend:8080
    }
    
    handle /v3/api-docs {
        reverse_proxy backend:8080
    }
    
    # Static assets (images, fonts, etc.) - PRESERVAR HEADERS DE NGINX
    handle /assets/* {
        reverse_proxy frontend:80 {
            # IMPORTANTE: Pasar headers del backend sin modificar
            header_up Host {host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
    }
    
    # Health check endpoint (always respond)
    handle /health {
        respond "OK" 200
        header Content-Type text/plain
    }
    
    # Handle OPTIONS requests for CORS - DENTRO del bloque del sitio
    @options method OPTIONS
    handle @options {
        respond "" 204
    }
} 

# Redirect www to non-www
www.fonzigo.app {
    redir https://fonzigo.app{uri} permanent
} 

# HTTP to HTTPS redirect (for all domains)
:80 {
    # Handle Let's Encrypt challenges
    handle /.well-known/acme-challenge/* {
        respond "{uri}" 200
    }
    
    # Redirect everything else to HTTPS
    redir https://{host}{uri} permanent
}
    
        # Handle OPTIONS requests for CORS
        @options method OPTIONS
        handle @options {
            respond "" 204
        }
    } 
} 

# Redirect www to non-www
www.fonzigo.app {
    redir https://fonzigo.app{uri} permanent
}

# HTTP to HTTPS redirect (for all domains)
:80 {
    # Handle Let's Encrypt challenges
    handle /.well-known/acme-challenge/* {
        respond "{uri}" 200
    }
    
    # Redirect everything else to HTTPS
    redir https://{host}{uri} permanent
}
