# ==============================================================================
# FonziGo - Caddy Configuration for fonzigo.app
# Automatic SSL via Let's Encrypt
# ==============================================================================

# Global options
{
    # Email for SSL certificate notifications
    email admin@fonzigo.app
    
    # Disable admin API in production (security)
    admin off
    
    # Log configuration
    log {
        output file /var/log/caddy/access.log {
            roll_size 100mb
            roll_keep 5
            roll_keep_for 720h
        }
        format json
        level INFO
    }
}

# Main domain - fonzigo.app
fonzigo.app {
    # Encode response with gzip
    encode gzip zstd

    # Handle OPTIONS requests for CORS preflight (PRIMERO - antes de otros handlers)
    @options method OPTIONS
    handle @options {
        header Access-Control-Allow-Origin "https://fonzigo.app"
        header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, PATCH, OPTIONS"
        header Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
        header Access-Control-Allow-Credentials "true"
        header Access-Control-Max-Age "86400"
        respond "" 204
    }

    # Health check endpoint
    handle /health {
        respond "OK" 200
    }

    # Backend API - CORS manejado por Spring, NO por Caddy
    handle /api/* {
        reverse_proxy backend:8080 {
            health_uri /actuator/health
            health_interval 30s
            health_timeout 5s
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Swagger UI
    handle /swagger-ui* {
        reverse_proxy backend:8080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    handle /v3/api-docs* {
        reverse_proxy backend:8080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Static assets
    handle /assets/* {
        reverse_proxy frontend:80 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Frontend (Angular SPA) - catch-all, debe ir al final
    handle {
        reverse_proxy frontend:80 {
            health_uri /health
            health_interval 30s
            health_timeout 5s
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
}

# Redirect www to non-www
www.fonzigo.app {
    redir https://fonzigo.app{uri} permanent
}

# HTTP to HTTPS redirect (for all domains)
:80 {
    # Health check para Docker (NO redirigir a HTTPS)
    handle /health {
        respond "OK" 200
    }

    # Handle Let's Encrypt challenges
    handle /.well-known/acme-challenge/* {
        respond "{uri}" 200
    }

    # Redirect everything else to HTTPS
    redir https://{host}{uri} permanent
}
