# ==============================================================================
# FonziGo - Production Environment Variables
# ⚠️  COPY THIS TO .env AND UPDATE ALL VALUES!
# ==============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
POSTGRES_DB=fonzigo_prod
POSTGRES_USER=fonzi
# ⚠️  CHANGE THIS TO A STRONG PASSWORD! Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=GENERATE_STRONG_PASSWORD_HERE
POSTGRES_HOST=database
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Backend Configuration
# -----------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://database:5432/fonzigo_prod
SPRING_DATASOURCE_USERNAME=fonzi
# ⚠️  CHANGE THIS TO MATCH POSTGRES_PASSWORD!
SPRING_DATASOURCE_PASSWORD=GENERATE_STRONG_PASSWORD_HERE
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false

# JWT Configuration (PROD - MUST be strong!)
# ⚠️  GENERATE A 256+ BIT RANDOM KEY! Use: openssl rand -base64 64
SECURITY_JWT_SECRET_KEY=CHANGE_ME_TO_A_VERY_LONG_RANDOM_STRING_MIN_256_BITS_REPLACE_WITH_ACTUAL_SECRET
SECURITY_JWT_EXPIRATION_TIME=86400000

# Google OAuth (use your production client ID)
GOOGLE_CLIENT_ID=YOUR_PRODUCTION_GOOGLE_CLIENT_ID

# Server Configuration
SERVER_PORT=8080
TZ=Europe/Madrid

# Frontend Configuration
FRONTEND_PORT=3000
API_URL=https://fonzigo.app/api

# Caddy Configuration
CADDY_EMAIL=admin@fonzigo.app
CADDY_DOMAIN=fonzigo.app

# CORS Configuration (Production URLs)
ALLOWED_ORIGINS=https://fonzigo.app,https://www.fonzigo.app

# File Upload Configuration
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=10MB
